{% extends 'base.html.twig' %}
{% block title %}Профиль — EVA{% endblock %}
{% block body %}
<h1>Профиль</h1>
<form method="post" class="card">
    <label>Имя <input name="name" value="{{ app.user.name }}" required maxlength="100"></label>
    {% if app.user.email %}
        <label>Email <input value="{{ app.user.email }}" disabled></label>
    {% else %}
        <label>Email <small class="muted">— чтобы входить и по паролю</small><input type="email" name="email" autocomplete="email"></label>
    {% endif %}
    <label>Основная валюта (итоги в «Личном») {% include '_currency_select.html.twig' with {value: app.user.currency} %}</label>
    <label>Часовой пояс <small class="muted">— от него зависят «сегодня» и границы месяцев</small>
        <select name="timezone">
            <option value="auto" {{ app.user.timezoneAuto ? 'selected' }}>Как на устройстве (сейчас {{ app.user.timezone }})</option>
            {% for tz in ['Asia/Yerevan', 'Europe/Moscow', 'Asia/Tbilisi', 'Asia/Almaty', 'Asia/Tashkent', 'Europe/Minsk', 'Europe/Istanbul', 'Asia/Dubai', 'Europe/Kyiv', 'Europe/Belgrade', 'Europe/Berlin', 'Europe/London', 'Asia/Bangkok', 'America/New_York', 'UTC'] %}
                <option value="{{ tz }}" {{ not app.user.timezoneAuto and app.user.timezone == tz ? 'selected' }}>{{ tz }}</option>
            {% endfor %}
        </select>
    </label>
    <details {{ not app.user.email ? 'open' }}>
        <summary>{{ app.user.password ? 'Сменить пароль' : 'Задать пароль' }}</summary>
        {% if app.user.password %}<label>Текущий пароль <input type="password" name="password" autocomplete="current-password"></label>{% endif %}
        <label>Новый пароль <input type="password" name="new_password" minlength="8" autocomplete="new-password"></label>
    </details>
    <input type="hidden" name="_token" value="{{ csrf_token('form') }}">
    <button class="btn primary">Сохранить</button>
</form>
{% if telegram_bot() or app.user.telegramId %}
<section class="card">
    <h2>Telegram</h2>
    {% if app.user.telegramId %}
        <p>✅ Привязан — можно входить через Telegram.</p>
        <form method="post" action="{{ path('profile_telegram_unlink') }}" data-confirm="Отвязать Telegram?">
            <input type="hidden" name="_token" value="{{ csrf_token('form') }}"><button class="btn small">Отвязать</button>
        </form>
    {% else %}
        <p class="muted">Привяжите Telegram, чтобы входить в один тап.</p>
        {% include '_telegram_button.html.twig' with {href: path('profile_telegram_link'), label: 'Привязать Telegram'} %}
    {% endif %}
</section>
{% endif %}
<section class="card">
    <h2>Тема оформления</h2>
    <div class="seg" role="radiogroup" aria-label="Тема">
        <label><input type="radio" name="theme_choice" value=""><span>◐ Системная</span></label>
        <label><input type="radio" name="theme_choice" value="light"><span>☀ Светлая</span></label>
        <label><input type="radio" name="theme_choice" value="dark"><span>☾ Тёмная</span></label>
    </div>
    <small class="muted">Запоминается в этом браузере.</small>
</section>
<form method="post" action="{{ path('logout') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button class="btn">Выйти</button></form>
{% endblock %}
