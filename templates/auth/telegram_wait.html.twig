{% extends 'auth/_layout.html.twig' %}
{% block title %}Вход через Telegram — EVA{% endblock %}
{% block form %}
<div class="tg-wait" data-tg-wait data-check="{{ path('login_telegram_check') }}" data-web="{{ web }}" data-app="{{ appLink }}">
    <div class="tg-wait-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path fill="currentColor" d="M21.9 4.6 18.8 19.3c-.2 1-.8 1.3-1.7.8l-4.7-3.5-2.3 2.2c-.3.3-.5.5-1 .5l.3-4.8 8.8-7.9c.4-.3-.1-.5-.6-.2L6.8 13.2l-4.6-1.4c-1-.3-1-1 .2-1.5L20.5 3.3c.8-.3 1.6.2 1.4 1.3z"/></svg>
    </div>
    <h2>{{ linking ? 'Привязка Telegram' : 'Вход через Telegram' }}</h2>
    <ol class="tg-steps">
        <li>Откройте Telegram кнопкой ниже</li>
        <li>Нажмите <b>«Старт»</b> в чате с ботом</li>
        <li>Подтвердите: <b>«✅ Да, это я»</b></li>
    </ol>
    <a class="btn primary wide tg-open" href="{{ web }}" data-tg-open>Открыть Telegram</a>
    <p class="tg-fallback muted">Нет приложения? <a href="{{ web }}" target="_blank" rel="noopener">Открыть в веб-версии</a></p>

    <p class="tg-status" data-tg-status aria-live="polite"><span class="spinner" aria-hidden="true"></span> Ждём подтверждения в Telegram…</p>
    <p class="auth-switch"><a href="{{ linking ? path('profile') : path('login') }}">← Назад</a></p>
</div>
{% endblock %}
