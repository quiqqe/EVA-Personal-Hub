{# password input with a show/hide toggle #}
<span class="pw">
    <input type="password" name="{{ name|default('password') }}" required {{ minlength is defined ? 'minlength=' ~ minlength }} autocomplete="{{ autocomplete }}" id="{{ id }}">
    <button type="button" class="pw-toggle" data-pw-toggle aria-label="Показать пароль" aria-controls="{{ id }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
    </button>
</span>
