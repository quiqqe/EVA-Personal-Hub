{% extends 'auth/_layout.html.twig' %}
{% block title %}Вход — EVA{% endblock %}
{% block form %}
<form method="post" class="auth-form">
    <h2>С возвращением 👋</h2>
    <p class="muted">Войдите, чтобы продолжить</p>
    {% if invitedTo %}<div class="flash flash-ok">👥 Вы вступаете в группу «{{ invitedTo.name }}» — войдите или зарегистрируйтесь, и сразу попадёте туда.</div>{% endif %}
    {% if error %}<div class="flash flash-error" role="alert">{{ error.messageKey starts with 'Too many' ? 'Слишком много попыток входа — подождите минуту и попробуйте снова.' : 'Неверный email или пароль' }}</div>{% endif %}

    {% if telegram_bot() %}
        {% include '_telegram_button.html.twig' with {href: path('login_telegram')} %}
        <div class="or"><span>или по email</span></div>
    {% endif %}

    <label for="email">Email</label>
    <input type="email" name="email" id="email" value="{{ email }}" required autofocus autocomplete="email" inputmode="email" placeholder="you@example.com">

    <label for="password" class="label-row">Пароль {% if telegram_bot() %}<a href="{{ path('password_forgot') }}">Забыли?</a>{% endif %}</label>
    {% include 'auth/_password.html.twig' with {id: 'password', autocomplete: 'current-password'} %}

    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
    <button class="btn primary wide auth-submit">Войти</button>
    <p class="auth-switch">Нет аккаунта? <a href="{{ path('register') }}">Зарегистрироваться</a></p>
</form>
{% endblock %}
