{% extends 'money/layout.html.twig' %}
{# shared by operations and recurring templates (recurring = true) #}
{% set recurring = recurring|default(false) %}
{% if not recurring %}
    {% set split = post.split is defined or (not post and o.splits|length > 0) %}
    {% set entered = split_entered(o) %}
    {% set byUser = {} %}
    {% for sp in o.splits %}{% set byUser = byUser|merge({(sp.user.id.toRfc4122): sp}) %}{% endfor %}
    {% set mode = post.split_mode ?? o.splitMode ?? 'equal' %}
    {% set participants = post.participants ?? (o.splits|length ? o.splits|filter(sp => sp.amount > 0)|map(sp => sp.user.id.toRfc4122) : members|keys) %}
    {% set payer = post.paid_by ?? (o.paidBy ? o.paidBy.id.toRfc4122 : (o.splits|length ? 'many' : app.user.id.toRfc4122)) %}
{% endif %}
{% block body %}
<h1>{{ recurring ? (isNew ? 'Регулярная операция' : 'Изменить регулярную') : (isNew ? 'Новая операция' : 'Операция') }}</h1>
{% if not sources and not o.account %}
<section class="card">
    <h2>Сначала нужен счёт</h2>
    <p class="muted">Операция всегда записывается на счёт — туда, где лежат деньги. Выберите, что завести: после сохранения вернёмся сюда.</p>
    {% include 'money/_quick_accounts.html.twig' with {return: app.request.requestUri} %}
</section>
{% else %}
<form method="post" class="card op-form" data-op-form data-group="{{ scope.group ? scope.group.id }}" data-share-url="{{ scope.group ? path('money_account_share', {scope: 'me', id: '00000000-0000-0000-0000-00000000000a', group: '00000000-0000-0000-0000-00000000000b'}) }}" data-token="{{ csrf_token('form') }}">
    {% for e in errors %}<div class="flash flash-error">{{ e }}</div>{% endfor %}
    <div class="seg">
        {% for k, v in constant('App\\Money\\Entity\\Operation::TYPES') %}
            <label><input type="radio" name="type" value="{{ k }}" {{ (post.type ?? o.type) == k ? 'checked' }}><span>{{ v }}</span></label>
        {% endfor %}
    </div>

    {# the sum as it was paid/received; its currency may differ from the account's #}
    {% set enteredCur = post.amount_currency ?? o.origCurrency ?? (o.account ? o.account.currency : null) %}
    {% set accCur = o.account ? o.account.currency : scope.currency %}
    {% set enteredAmount = o.origAmount is not null ? o.origAmount|money_input(o.origCurrency) : (o.amount ? o.amount|money_input(accCur) : '') %}
    <div class="amount-row">
        <label class="amount">Сумма
            <input name="amount" inputmode="decimal" autocomplete="off" required value="{{ post.amount ?? enteredAmount }}" placeholder="0" {{ isNew ? 'autofocus' }}>
        </label>
        <label class="amount-cur" data-amount-cur>Валюта
            {% include '_currency_select.html.twig' with {name: 'amount_currency', value: enteredCur ?? scope.currency, short: true} %}
        </label>
    </div>
    <small class="muted amount-hint">Можно считать: 250+120. Валюта может отличаться от валюты счёта — пересчитаем по курсу.</small>


    {% if scope.group and not recurring %}
    <div data-show="expense">
        <label class="check"><input type="checkbox" name="split" value="1" {{ split ? 'checked' }} data-split> 👥 Разделить между участниками</label>
        <div data-split-box class="split-box">
            <label>Кто платил
                <select name="paid_by" data-payer data-me="{{ app.user.id }}">
                    {% for id, u in members %}<option value="{{ id }}" {{ payer == id ? 'selected' }}>{{ u.name }}{{ u == app.user ? ' (я)' }}{{ u not in scope.members ? ' (вышел)' }}</option>{% endfor %}
                    <option value="many" {{ payer == 'many' ? 'selected' }}>Несколько человек…</option>
                </select>
            </label>
            <div class="seg seg-4" role="radiogroup" aria-label="Как делить">
                {% for k, v in constant('App\\Money\\Debts::MODES') %}
                    <label><input type="radio" name="split_mode" value="{{ k }}" {{ mode == k ? 'checked' }}><span>{{ v }}</span></label>
                {% endfor %}
            </div>
            <div class="people" data-people>
                <div class="person person-head"><span>Участник</span><span data-col-part>Доля</span><span data-col-paid>Заплатил</span></div>
                {% for id, u in members %}
                    {% set sp = byUser[id] ?? null %}
                    {% set partValue = post.part[id] ?? (sp and sp.amount > 0 ? (mode == 'amounts' ? (entered.owed[id] ?? 0)|money_input(entered.currency) : (sp.weight ?? '')) : '') %}
                    <div class="person">
                        <label class="check"><input type="checkbox" name="participants[]" value="{{ id }}" data-equal-only {{ id in participants ? 'checked' }}><span>{{ u.name }}{{ u == app.user ? ' (я)' }}{{ u not in scope.members ? ' (вышел)' }}</span></label>
                        <input name="part[{{ id }}]" value="{{ partValue }}" inputmode="decimal" data-part data-id="{{ id }}" aria-label="Доля: {{ u.name }}">
                        <input name="paid[{{ id }}]" value="{{ post.paid[id] ?? ((entered.paid[id] ?? 0) > 0 ? entered.paid[id]|money_input(entered.currency) : '') }}" inputmode="decimal" placeholder="0" data-paid data-id="{{ id }}" aria-label="Заплатил: {{ u.name }}">
                    </div>
                {% endfor %}
                <small class="muted" data-split-hint aria-live="polite"></small>
            </div>
            <label data-other-currency>Валюта {% include '_currency_select.html.twig' with {value: post.currency ?? o.currency ?? scope.currency} %}</label>
        </div>
    </div>
    {% endif %}

    <label data-account>Счёт
        <select name="account" data-currency-source>
            {% set current = post.account ?? (o.account ? o.account.id.toRfc4122 : '') %}
            {% if o.account and o.account not in sources %}<option value="{{ o.account.id }}" data-cur="{{ o.account.currency }}" data-owner="{{ o.account.user ? o.account.user.id }}" data-name="{{ o.account.name }}" selected>{{ o.account.label }}</option>{% endif %}
            {% for a in sources %}<option value="{{ a.id }}" data-cur="{{ a.currency }}" data-name="{{ a.name }}" data-group="{{ a.group ? a.group.id }}" data-mine="{{ a.user == app.user ? 1 : '' }}" data-owner="{{ a.user ? a.user.id }}" data-shared="{{ a.sharedWith|map(g => g.id.toRfc4122)|join(' ') }}" {{ current == a.id.toRfc4122 ? 'selected' }}>{{ a.icon }} {{ scope.group ? a.label : a.name }} · {{ a.currency }}</option>{% endfor %}
        </select>
        {% if not sources %}<a href="{{ path('money_account_new', {scope: scope.key}) }}">Сначала добавьте счёт</a>{% endif %}
    </label>
    {% if scope.group and not recurring %}
    <div class="hint" data-hint-topup hidden>
        💡 Пополняете общий счёт деньгами <b>со своей карты</b>? Тогда это перевод: с карты спишется, на общий счёт придёт. «Доход» — только для новых денег извне (например, зарплата сразу на общую карту).
        <button type="button" class="btn small" data-make-transfer>Сделать переводом</button>
    </div>
    <div class="hint" data-hint-unshared hidden>
        💡 Карта «<span data-hint-account></span>» не показана группе: операция будет во «Внесено в группе», но не в «Общих деньгах» группы.
        <button type="button" class="btn small" data-share-account>Показать карту группе</button>
    </div>
    {% endif %}

    {% if recurring %}
    <div class="fx fx-foreign" data-fx-foreign>
        <small class="muted fx-hint">Каждый платёж пересчитается в валюту счёта по рыночному курсу на его дату. Реальный курс можно потом поправить в самой операции.</small>
    </div>
    {% else %}
    <div class="fx fx-foreign" data-fx-foreign>
        <label>Курс <small class="muted" data-fx-rate-label></small>
            <input name="fx_rate" inputmode="decimal" autocomplete="off" data-fx-rate2 value="{{ post.fx_rate ?? '' }}">
        </label>
        <label><span data-fx-credited-label>На счёт</span> <small class="muted" data-fx-acc-cur></small>
            <input name="account_amount" inputmode="decimal" autocomplete="off" data-fx-credited value="{{ post.account_amount ?? (o.origAmount is not null ? o.amount|money_input(o.currency) : '') }}">
            <input type="hidden" name="account_amount_for" data-fx-credited-for value="{{ post.account_amount_for ?? (o.account ? o.account.id) }}">
        </label>
        <small class="muted fx-hint">Подставлен рыночный курс на дату операции. Обменник или банк дали другой — впишите его курс или сумму, которая реально пришла на счёт.</small>
    </div>
    {% endif %}

    <div data-show="transfer">
        <label>Куда
            <select name="to_account" data-currency-target>
                {% set to = post.to_account ?? (o.toAccount ? o.toAccount.id.toRfc4122 : '') %}
                <option value="">—</option>
                {% for a in targets %}<option value="{{ a.id }}" data-cur="{{ a.currency }}" {{ to == a.id.toRfc4122 ? 'selected' }}>{{ a.icon }} {{ a.label }} · {{ a.currency }}</option>{% endfor %}
            </select>
        </label>
        <div data-to-amount class="fx">
            <label>Получено <small class="muted" data-to-cur></small>
                <input name="to_amount" inputmode="decimal" data-fx-to value="{{ post.to_amount ?? (o.toAmount and o.toAccount ? o.toAmount|money_input(o.toAccount.currency) : '') }}">
            </label>
            <label>Курс <small class="muted" data-rate-label>за 1</small>
                <input name="rate" inputmode="decimal" data-fx-rate value="{{ post.rate ?? '' }}" placeholder="как в обменнике">
            </label>
            <small class="muted fx-hint">Обмен валют (в т. ч. крипты в обменнике) — это перевод между счетами в разных валютах. Укажите полученную сумму или курс — второе посчитается.</small>
        </div>
    </div>

    <div class="cat-chips" data-cat-chips>
        {% for kind in ['expense', 'income'] %}{% for c in topCategories[kind] %}<button type="button" class="chip" data-chip="{{ c.id }}" data-kind="{{ kind }}">{{ c.label }}</button>{% endfor %}{% endfor %}
    </div>
    <label data-category>Категория
        {% set cat = post.category ?? (o.category ? o.category.id.toRfc4122 : '') %}
        <select name="category">
            <option value="">Без категории</option>
            {% for kind, label in {expense: 'Расходы', income: 'Доходы'} %}
            <optgroup label="{{ label }}" data-kind="{{ kind }}">
                {% for c in categories[kind] %}<option value="{{ c.id }}" {{ cat == c.id.toRfc4122 ? 'selected' }}>{{ c.label }}</option>{% endfor %}
            </optgroup>
            {% endfor %}
        </select>
    </label>

    {% if recurring %}
    <label>Повторять
        <select name="period">{% for k, v in periods %}<option value="{{ k }}" {{ (post.period ?? o.period) == k ? 'selected' }}>{{ v }}</option>{% endfor %}</select>
    </label>
    <label>Первый платёж <input type="date" name="date" value="{{ post.date ?? o.startDate.format('Y-m-d') }}" required data-recurring-start data-today="{{ 'now'|date('Y-m-d') }}"></label>
    {% if isNew %}
    <div class="hint" data-backfill hidden>
        Дата в прошлом. Что сделать с уже прошедшими платежами?
        <label class="check"><input type="radio" name="backfill" value="1" {{ (post.backfill ?? '1') == '1' ? 'checked' }}> Записать их задним числом (с этой даты по сегодня)</label>
        <label class="check"><input type="radio" name="backfill" value="0" {{ (post.backfill ?? '1') == '0' ? 'checked' }}> Не записывать — начать со следующего платежа</label>
    </div>
    {% else %}
    <small class="muted">При смене даты или периода уже созданные операции не повторяются — расписание продолжится со следующей даты.</small>
    {% endif %}
    {% else %}
    <label>Дата
        <input type="date" name="date" value="{{ post.date ?? o.date.format('Y-m-d') }}" required>
    </label>
    {% endif %}

    <label>Комментарий <input name="note" maxlength="255" value="{{ post.note ?? o.note }}" placeholder="Необязательно"></label>

    <input type="hidden" name="_token" value="{{ csrf_token('form') }}">
    <div class="actions">
        <button class="btn primary">Сохранить</button>
        {% if isNew and not recurring %}<button class="btn" name="more" value="1">Сохранить и ещё</button>{% endif %}
    </div>
</form>
{% endif %}
{% if not isNew and not recurring %}
<form method="post" action="{{ path('money_operation_delete', {scope: scope.key, id: o.id}) }}" data-confirm="Удалить операцию?">
    <input type="hidden" name="_token" value="{{ csrf_token('form') }}"><button class="btn danger">Удалить</button>
</form>
{% endif %}
{% endblock %}
