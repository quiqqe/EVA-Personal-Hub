{% extends 'money/layout.html.twig' %}
{% block body %}
{% set base = {scope: scope.key}|merge(filters|filter(v => v)) %}
{% if account %}
<section class="card account-card">
    <div class="row">
        <span><span class="acc-icon">{{ account.icon }}</span><b>{{ account.name }}</b>{% if account.archived %} <span class="badge">архив</span>{% endif %}</span>
        {% if scope.owns(account) %}<a class="btn small" href="{{ path('money_account_edit', {scope: scope.key, id: account.id}) }}">✏️ Изменить</a>{% else %}<small class="muted">счёт {{ account.user.name ?? '' }}</small>{% endif %}
    </div>
    <div class="account-sums">
        <div><small class="muted">Баланс</small><b class="{{ balance < 0 ? 'expense' }}">{{ balance|money(account.currency) }}</b></div>
        <div><small class="muted">Начальный остаток</small><b>{{ account.initialBalance|money(account.currency) }}</b></div>
    </div>
    <div class="actions">
        <a class="btn small expense" href="{{ path('money_operation_new', {scope: scope.key, type: 'expense', account: account.id}) }}">− Расход</a>
        <a class="btn small income" href="{{ path('money_operation_new', {scope: scope.key, type: 'income', account: account.id}) }}">+ Доход</a>
        <a class="btn small" href="{{ path('money_operation_new', {scope: scope.key, type: 'transfer', account: account.id}) }}">⇄ Перевод</a>
    </div>
    {% if account.initialBalance != 0 %}<small class="muted">Начальный остаток — сколько было на счёте до начала учёта. Изменить можно в «✏️ Изменить».</small>{% endif %}
    {% if scope.owns(account) %}
    <details class="reconcile">
        <summary>🧮 Сверить остаток</summary>
        <form method="post" action="{{ path('money_account_reconcile', {scope: scope.key, id: account.id}) }}" class="inline">
            <input type="hidden" name="_token" value="{{ csrf_token('form') }}">
            <input name="actual" inputmode="decimal" placeholder="Сколько на самом деле, {{ account.currency }}" required aria-label="Фактический остаток">
            <button class="btn small primary">Сверить</button>
        </form>
        <small class="muted">Посчитали наличные или открыли банк, а сумма другая? Разница запишется операцией «Корректировка остатка» сегодня — история не меняется.</small>
    </details>
    {% endif %}
</section>
{% endif %}
{% if range and not q %}
<div class="month-nav">
    <span></span>
    <b>{{ range[0]|date('d.m.Y') }} – {{ range[1]|date('d.m.Y') }}</b>
    <a href="{{ path('money_operations', base) }}" aria-label="К месяцу">×</a>
</div>
{% else %}
<div class="month-nav">
    <a href="{{ path('money_operations', base|merge({m: month.modify('-1 month').format('Y-m')})) }}" aria-label="Предыдущий месяц">‹</a>
    <b>{{ q ? 'Поиск: «' ~ q ~ '»' : month|date('m.Y') }}</b>
    <a href="{{ path('money_operations', base|merge({m: month.modify('+1 month').format('Y-m')})) }}" aria-label="Следующий месяц">›</a>
</div>
{% endif %}
<form class="filters" method="get" data-autosubmit>
    <noscript><button class="btn small">Показать</button></noscript>
    <input type="hidden" name="m" value="{{ month.format('Y-m') }}">
    {% if range %}<input type="hidden" name="from" value="{{ range[0].format('Y-m-d') }}"><input type="hidden" name="to" value="{{ range[1].format('Y-m-d') }}">{% endif %}
    <input type="search" name="q" value="{{ q }}" placeholder="🔍 Комментарий, категория или сумма">
    <select name="account"><option value="">Все счета</option>{% for a in accounts %}<option value="{{ a.id }}" {{ filters.account == a.id.toRfc4122 ? 'selected' }}>{{ a.name }}</option>{% endfor %}</select>
    <select name="category"><option value="">Все категории</option><option value="none" {{ filters.category == 'none' ? 'selected' }}>Без категории</option>{% for c in categories %}<option value="{{ c.id }}" {{ filters.category == c.id.toRfc4122 ? 'selected' }}>{{ c.label }}</option>{% endfor %}</select>
    <select name="type"><option value="">Все типы</option>{% for k, v in constant('App\\Money\\Entity\\Operation::TYPES') %}<option value="{{ k }}" {{ filters.type == k ? 'selected' }}>{{ v }}</option>{% endfor %}</select>
</form>
{% set undo = app.session.get('import_undo') %}
{% if undo and undo.scope == scope.key %}
<form method="post" action="{{ path('money_import_undo', {scope: scope.key, batch: undo.batch}) }}" class="hint undo-import" data-confirm="Удалить все {{ undo.count }} операций из этого импорта?">
    📥 Только что импортировано {{ undo.count }}. Что-то не так?
    <input type="hidden" name="_token" value="{{ csrf_token('form') }}"><button class="btn small">Отменить этот импорт</button>
</form>
{% endif %}
{% if sum.count %}
<div class="list-sum">
    <span>{{ sum.count }} {{ sum.count % 10 == 1 and sum.count % 100 != 11 ? 'операция' : (sum.count % 10 in [2,3,4] and sum.count % 100 not in [12,13,14] ? 'операции' : 'операций') }}{{ q ? ' найдено' }}</span>
    {% if sum.income %}<b class="income">+{{ sum.income|money(in, true) }}</b>{% endif %}
    {% if sum.expense %}<b class="expense">−{{ sum.expense|money(in, true) }}</b>{% endif %}
    {% if sum.missing %}<small class="muted">без учёта {{ sum.missing|join(', ') }}</small>{% endif %}
</div>
{% endif %}
{% for day, ops in days %}
    <h3 class="day"><span>{{ day|date('d.m.Y, D')|replace({Mon: 'пн', Tue: 'вт', Wed: 'ср', Thu: 'чт', Fri: 'пт', Sat: 'сб', Sun: 'вс'}) }}</span>{% if dayNet[day] is defined and dayNet[day] != 0 %}<span class="{{ dayNet[day] > 0 ? 'income' : 'expense' }}">{{ dayNet[day] > 0 ? '+' : '−' }}{{ (dayNet[day]|abs)|money(in, true) }}</span>{% endif %}</h3>
    <section class="card">{% for o in ops %}{% include 'money/_op.html.twig' %}{% endfor %}</section>
{% else %}
    <p class="muted center">Операций нет</p>
{% endfor %}
{% endblock %}
