{% extends 'base.html.twig' %}
{% block title %}{{ scope.name }} — Деньги{% endblock %}
{% block header_center %}
    <select class="scope-switch" data-nav aria-label="Пространство">
        <option value="{{ path('money', {scope: 'me'}) }}" {{ not scope.group ? 'selected' }}>👤 Личное</option>
        {% for g in my_groups() %}
            <option value="{{ path('money', {scope: g.id}) }}" {{ scope.group == g ? 'selected' }}>👥 {{ g.name }}</option>
        {% endfor %}
        <option value="{{ path('groups') }}">＋ Группы…</option>
    </select>
{% endblock %}
{% block nav %}
{% set s = scope.key %}
{% set r = app.request.attributes.get('_route') %}
<nav class="bottom" aria-label="Разделы">
    <a href="{{ path('money', {scope: s}) }}" class="{{ r == 'money' ? 'on' }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6h-6v6H4a1 1 0 0 1-1-1z"/></svg>Главная</a>
    <a href="{{ path('money_operations', {scope: s}) }}" class="{{ r starts with 'money_operation' ? 'on' }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3.5 6h.01M3.5 12h.01M3.5 18h.01"/></svg>Операции</a>
    <a href="{{ path('money_operation_new', {scope: s}) }}" class="plus" aria-label="Добавить операцию"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg></a>
    <a href="{{ path('money_reports', {scope: s}) }}" class="{{ r == 'money_reports' ? 'on' }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg>Отчёты</a>
    <details class="more">
        <summary><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="5" cy="12" r="1.2"/><circle cx="12" cy="12" r="1.2"/><circle cx="19" cy="12" r="1.2"/></svg>Ещё</summary>
        <div class="menu">
            <a href="{{ path('money_accounts', {scope: s}) }}">🏦 Счета</a>
            <a href="{{ path('money_plan', {scope: s}) }}">🎯 Бюджеты, цели, регулярные</a>
            {% if scope.group %}<a href="{{ path('money_debts', {scope: s}) }}">🤝 Долги в группе</a>{% endif %}
            <a href="{{ path('money_categories', {scope: s}) }}">🏷️ Категории</a>
            <a href="{{ path('money_import', {scope: s}) }}">📥 Импорт выписки</a>
            <a href="{{ path('money_export', {scope: s}) }}">📤 Экспорт в CSV</a>
            {% if scope.group %}<a href="{{ path('group', {id: s}) }}">⚙️ Группа и приглашения</a>{% endif %}
            <a href="{{ path('hub') }}">🧰 Все инструменты</a>
        </div>
    </details>
</nav>
{% endblock %}
