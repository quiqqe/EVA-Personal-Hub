{% extends 'money/layout.html.twig' %}
{% block body %}
<h1>Долги в группе</h1>
<p class="muted">Считаются по разделённым расходам: кто сколько заплатил и чья доля сколько.</p>
{% for c, d in debts %}
<section class="card">
    <h2>{{ c }}</h2>
    {% for uid, v in d.net %}
        <div class="row"><span>{{ members[uid].name ?? '?' }}{{ uid not in current ? ' (вышел)' }}</span>
            <b class="{{ v > 0 ? 'income' : (v < 0 ? 'expense') }}">{{ v > 0 ? 'получит ' : (v < 0 ? 'отдаст ' : 'в расчёте') }}{{ v != 0 ? (v|abs)|money(c) }}</b></div>
    {% endfor %}
    {% if d.plan %}
        <h3>Как рассчитаться</h3>
        {% for p in d.plan %}
            <div class="row">
                <span>{{ members[p.from].name ?? '?' }} → {{ members[p.to].name ?? '?' }}: <b>{{ p.amount|money(c) }}</b></span>
                {% if app.user.id.toRfc4122 in [p.from, p.to] %}
                <a class="btn small primary" href="#settle" data-settle-fill='{{ {from: p.from, to: p.to, currency: c, paid_currency: c, paid_amount: p.amount|money_input(c)}|json_encode }}'>Рассчитаться</a>
                {% else %}<small class="muted">записывают они сами</small>{% endif %}
            </div>
        {% endfor %}
    {% else %}
        <p class="muted">Все в расчёте 🎉</p>
    {% endif %}
</section>
{% else %}
<section class="card"><p class="muted">Пока нет разделённых трат. При вводе расхода в группе отметьте «👥 Разделить».</p></section>
{% endfor %}

<form method="post" class="card stack" id="settle" data-settle>
    <h2>Записать возврат долга</h2>
    <input type="hidden" name="_token" value="{{ csrf_token('form') }}">
    {% set firstOther = members|filter(u => u != app.user)|first %}
    <label>Кто отдал <select name="from">{% for id, u in members %}<option value="{{ id }}" {{ u == app.user ? 'selected' }}>{{ u.name }}{{ id not in current ? ' (вышел)' }}</option>{% endfor %}</select></label>
    <label>Кому <select name="to">{% for id, u in members %}<option value="{{ id }}" {{ firstOther and u == firstOther ? 'selected' }}>{{ u.name }}{{ id not in current ? ' (вышел)' }}</option>{% endfor %}</select></label>
    <label>Когда <input type="date" name="date" value="{{ 'now'|date('Y-m-d') }}" max="{{ 'now'|date('Y-m-d') }}" required></label>
    <small class="muted">Записать возврат может тот, кто отдавал или получал.</small>
    <div class="amount-row">
        <label>Сколько отдал <input name="paid_amount" inputmode="decimal" placeholder="Сумма" required></label>
        <label>Валюта {% include '_currency_select.html.twig' with {name: 'paid_currency', value: scope.currency, short: true} %}</label>
    </div>
    <label>Какой долг закрывает (валюта долга) {% include '_currency_select.html.twig' with {name: 'currency', value: scope.currency} %}</label>
    <div class="fx fx-foreign" data-settle-fx hidden>
        <label>Курс <small class="muted" data-settle-rate-label></small><input name="fx_rate" inputmode="decimal" autocomplete="off"></label>
        <label>Долга закрыто <small class="muted" data-settle-cur></small><input name="amount" inputmode="decimal" autocomplete="off"></label>
        <small class="muted fx-hint">Пусто — пересчитаем по рыночному курсу на сегодня.</small>
    </div>
    {% if myAccounts %}
    <label data-settle-account data-me="{{ app.user.id }}"><span data-settle-account-label>Мой счёт</span>
        <select name="account">
            <option value="">— не записывать на счёт</option>
            {% for a in myAccounts %}<option value="{{ a.id }}">{{ a.icon }} {{ a.name }} · {{ a.currency }}</option>{% endfor %}
        </select>
        <small class="muted" data-settle-account-hint></small>
    </label>
    {% endif %}
    <button class="btn primary small">Записать</button>
</form>

{% if settlements %}
<section class="card">
    <h2>История возвратов</h2>
    {% for st in settlements %}
        <form method="post" class="row">
            <span>{{ st.date|date('d.m.Y') }} · {{ st.from.name }} → {{ st.to.name }}</span>
            <b>{{ st.amount|money(st.currency) }}{% if st.origCurrency %} <small class="muted">({{ st.origAmount|money(st.origCurrency) }})</small>{% endif %}{% for o in st.operations %}{% if o.account %}<br><small class="muted">{{ o.type == 'income' ? 'доход на' : 'расход с' }} «{{ o.account.name }}» ({{ o.account.user.name ?? '' }})</small>{% endif %}{% endfor %}</b>
            <input type="hidden" name="_token" value="{{ csrf_token('form') }}">
            {% if st.from == app.user or st.to == app.user %}<button class="btn small" name="delete" aria-label="Удалить запись о возврате" value="{{ st.id }}" data-confirm="Удалить запись о возврате{{ st.operations ? ' и связанные операции на счетах' }}?">✕</button>{% endif %}
        </form>
        {% set mine = st.to == app.user ? (st.receiverOperation ? null : 'income') : (st.from == app.user ? (st.payerOperation ? null : 'expense') : null) %}
        {% if mine and myAccounts %}
        <form method="post" class="inline attach-row">
            <input type="hidden" name="_token" value="{{ csrf_token('form') }}">
            <select name="account" aria-label="Мой счёт">{% for a in myAccounts %}<option value="{{ a.id }}">{{ a.icon }} {{ a.name }} · {{ a.currency }}</option>{% endfor %}</select>
            <button class="btn small" name="attach" value="{{ st.id }}">{{ mine == 'income' ? '＋ Записать доход на мой счёт' : '− Записать расход с моего счёта' }}</button>
        </form>
        {% endif %}
    {% endfor %}
</section>
{% endif %}
{% endblock %}
