{% extends 'money/layout.html.twig' %}
{% set cur = in %}
{% block body %}
<section class="hero">
    <div class="hero-head"><small>{{ scope.group ? 'Общие деньги группы' : 'Всего на счетах' }}</small>{% include 'money/_in_switch.html.twig' %}</div>
    <div class="big">{{ total|money(cur, true) }}</div>
    {% if byCurrency|length > 1 %}<small class="sub">{% for c, v in byCurrency %}{{ v|money(c) }}{{ not loop.last ? ' · ' }}{% endfor %}</small>{% endif %}
    {% if missing %}<small class="sub">без учёта {{ missing|join(', ') }} — нет курса</small>{% endif %}
    <div class="month">
        <span>Доходы за месяц <b>+{{ income|money(cur, true) }}</b></span>
        <span>Расходы за месяц <b>−{{ expense|money(cur, true) }}</b></span>
    </div>
    {% if transfers.in or transfers.out %}<small class="sub">Переводы: {% if transfers.in %}+{{ transfers.in|money(cur, true) }} пришло{% endif %}{% if transfers.in and transfers.out %} · {% endif %}{% if transfers.out %}−{{ transfers.out|money(cur, true) }} ушло{% endif %} {{ scope.group ? '(с других счетов / на другие счета)' : '(на счета групп и с них)' }}</small>{% endif %}
    {% if flowMissing %}<small class="sub">без учёта {{ flowMissing|join(', ') }} — нет курса</small>{% endif %}
    {% if scope.group %}<small class="sub">По общим счетам группы и личным счетам, которые участники ей показывают. Возвраты долгов внутри группы — не доход и не расход.</small>{% endif %}
</section>

{% if entered %}
<section class="card entered">
    <div class="card-head"><h2>Внесено в группе за месяц</h2></div>
    <div class="account-sums">
        <div><small class="muted">Доходы</small><b class="income">+{{ entered.income|money(cur, true) }}</b></div>
        <div><small class="muted">Расходы</small><b class="expense">−{{ entered.expense|money(cur, true) }}</b></div>
    </div>
    <small class="muted">Всё, что внесли внутри группы, с любых счетов (в том числе личных) и разделённые траты — сколько группа потратила вместе. На остаток «Общих денег» влияет только то, что прошло через общие счета.</small>
</section>
{% endif %}

<div class="quick">
    <a class="btn expense" href="{{ path('money_operation_new', {scope: scope.key, type: 'expense'}) }}"><span>{{ icon('minus') }}</span>Расход</a>
    <a class="btn income" href="{{ path('money_operation_new', {scope: scope.key, type: 'income'}) }}"><span>{{ icon('plus') }}</span>Доход</a>
    <a class="btn" href="{{ path('money_operation_new', {scope: scope.key, type: 'transfer'}) }}"><span>{{ icon('exchange') }}</span>Перевод / обмен</a>
</div>

<section class="card">
    <div class="card-head"><h2>Счета</h2><a href="{{ path('money_account_new', {scope: scope.key}) }}">＋ счёт</a></div>
    <div class="list">
    {% for a in accounts %}
        <a class="row" href="{{ path('money_operations', {scope: scope.key, account: a.id}) }}">
            <span><span class="acc-icon">{{ icon(a.icon) }}</span>{{ a.name }}{% if scope.group and a.user %} <small class="muted">· {{ a.user.name }}</small>{% endif %}</span>
            <b class="{{ balances[a.id.toRfc4122] < 0 ? 'expense' }}">{{ balances[a.id.toRfc4122]|money(a.currency) }}</b>
        </a>
    {% else %}
        {% if scope.group %}
            <p class="muted">У группы пока нет общих денег. Создайте общий счёт (копилку, общую карту) — или покажите группе свой личный: «Личное» → «Счета» → счёт → «Показывать группам».</p>
            {% include 'money/_quick_accounts.html.twig' with {only: ['card', 'savings', 'cash']} %}
        {% else %}
            <p class="muted">С чего начать: заведите счета — где лежат ваши деньги. Остаток на сегодня можно указать сразу.</p>
            {% include 'money/_quick_accounts.html.twig' %}
        {% endif %}
    {% endfor %}
    </div>
</section>

{% if scope.group %}
<section class="card">
    <div class="card-head"><h2>Долги в группе</h2><a href="{{ path('money_debts', {scope: scope.key}) }}">открыть</a></div>
    {% for c, d in debts %}
        {% set mine = d.net[app.user.id.toRfc4122] ?? 0 %}
        {% if mine > 0 %}<p>Вам должны <b class="income">{{ mine|money(c) }}</b></p>
        {% elseif mine < 0 %}<p>Вы должны <b class="expense">{{ (-mine)|money(c) }}</b></p>
        {% else %}<p class="muted">В {{ c }} вы в расчёте</p>{% endif %}
    {% else %}
        <p class="muted">Все в расчёте. Разделить трату: при вводе расхода отметьте «Разделить».</p>
    {% endfor %}
</section>
{% elseif groupDebts %}
<section class="card">
    <div class="card-head"><h2>Долги в группах</h2></div>
    {% for gd in groupDebts %}
        <a class="row" href="{{ path('money_debts', {scope: gd.group.id}) }}">
            <span>{{ icon('users') }} {{ gd.group.name }}</span>
            <span>{% for c, v in gd.amounts %}<b class="{{ v > 0 ? 'income' : 'expense' }}">{{ v > 0 ? 'вам должны ' : 'вы должны ' }}{{ (v|abs)|money(c) }}</b>{{ not loop.last ? ' · ' }}{% endfor %}</span>
        </a>
    {% endfor %}
</section>
{% endif %}

{% if budgets %}
<section class="card">
    <div class="card-head"><h2>Бюджеты на месяц</h2><a href="{{ path('money_plan', {scope: scope.key}) }}">все</a></div>
    {% for b in budgets %}
        <div class="progress">
            <div class="row"><span>{{ b.budget.category.label }}</span><span>{{ b.spent|money(b.budget.currency, true) }} / {{ b.budget.amount|money(b.budget.currency, true) }}</span></div>
            {% include 'money/_bar.html.twig' with {value: b.spent, max: b.budget.amount} %}
        </div>
    {% endfor %}
</section>
{% endif %}

{% if goals %}
<section class="card">
    <div class="card-head"><h2>Цели</h2><a href="{{ path('money_plan', {scope: scope.key}) }}">все</a></div>
    {% for g in goals %}
        <div class="progress">
            <div class="row"><span>{{ icon('target') }} {{ g.goal.name }}</span><span>{{ g.saved|money(g.goal.account.currency) }} / {{ g.goal.target|money(g.goal.account.currency) }}</span></div>
            {% include 'money/_bar.html.twig' with {value: g.saved, max: g.goal.target} %}
        </div>
    {% endfor %}
</section>
{% endif %}

<section class="card">
    <div class="card-head"><h2>Последние операции</h2><a href="{{ path('money_operations', {scope: scope.key}) }}">все</a></div>
    {% for o in recent %}{% include 'money/_op.html.twig' %}{% else %}<p class="muted">Операций пока нет</p>{% endfor %}
</section>
{% endblock %}
