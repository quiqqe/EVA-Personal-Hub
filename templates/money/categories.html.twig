{% extends 'money/layout.html.twig' %}
{% block body %}
<h1>Категории</h1>
{% for kind, label in {expense: 'Расходы', income: 'Доходы'} %}
<section class="card">
    <h2>{{ label }}</h2>
    {% for c in categories|filter(c => c.kind == kind) %}
        <form method="post" class="cat-row {{ c.archived ? 'archived' }}">
            <input type="hidden" name="_token" value="{{ csrf_token('form') }}">
            <input type="hidden" name="id" value="{{ c.id }}">
            <input name="icon" value="{{ c.icon }}" class="emoji" maxlength="4" aria-label="Иконка">
            <input name="name" value="{{ c.name }}" required maxlength="100" aria-label="Название">
            <button class="btn small" aria-label="Сохранить" title="Сохранить">💾</button>
            <button class="btn small" name="archive" value="1" title="{{ c.archived ? 'Вернуть' : 'В архив' }}" aria-label="{{ c.archived ? 'Вернуть из архива' : 'В архив' }}">{{ c.archived ? '↩︎' : '🗄' }}</button>
        </form>
    {% endfor %}
    <form method="post" class="cat-row">
        <input type="hidden" name="_token" value="{{ csrf_token('form') }}">
        <input type="hidden" name="kind" value="{{ kind }}">
        <input name="icon" class="emoji" maxlength="4" placeholder="🙂" aria-label="Иконка">
        <input name="name" required maxlength="100" placeholder="Новая категория" aria-label="Название">
        <button class="btn small primary" aria-label="Добавить категорию">＋</button>
    </form>
</section>
{% endfor %}
<p class="muted small">Архивные категории не предлагаются при вводе, но остаются в старых операциях и отчётах.</p>
{% endblock %}
