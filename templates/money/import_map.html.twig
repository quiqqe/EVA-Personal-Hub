{% extends 'money/layout.html.twig' %}
{% block body %}
<h1>Проверьте выписку</h1>
<form method="post" class="card stack">
    <input type="hidden" name="mapped" value="1">
    <label>Счёт <select name="account" data-autosubmit-field>{% for a in accounts %}<option value="{{ a.id }}" {{ account == a ? 'selected' }}>{{ a.name }} · {{ a.currency }}</option>{% endfor %}</select></label>
    <details {{ not parsed ? 'open' }}>
        <summary>Колонки выписки</summary>
        {% for key, label in {date: 'Дата', amount: 'Сумма со знаком (в валюте счёта)', out: '…или отдельно: списание', in: '…и зачисление', note: 'Описание', category: 'Категория банка', orig_currency: 'Валюта покупки (если бывает другая)', orig_amount: 'Сумма в валюте покупки'} %}
            <label>{{ label }}
                <select name="{{ key }}" data-autosubmit-field>
                    <option value="">—</option>
                    {% for i, h in header %}<option value="{{ i }}" {{ cols[key] is same as(i) ? 'selected' }}>{{ h }}</option>{% endfor %}
                </select>
            </label>
        {% endfor %}
        <label class="check"><input type="checkbox" name="invert" value="1" {{ invert ? 'checked' }} data-autosubmit-field> Инвертировать знак (расходы в выписке без минуса)</label>
        <button class="btn small" name="preview" value="1">Обновить предпросмотр</button>
    </details>

    <h2>Строк: {{ parsed|length }}{% if skipped %} <small class="muted">(без даты/суммы или без курса — пропущено: {{ skipped }})</small>{% endif %}</h2>
    {% if parsed %}
    <p class="muted small">Снимите галочку у строк, которые не нужны. «⇄» — это перевод между вашими счетами (например, с карты на карту или снятие наличных): он не станет ни расходом, ни доходом.</p>
    <label>Второй счёт для строк-переводов
        <select name="transfer_account">
            <option value="">—</option>
            {% for a in others %}<option value="{{ a.id }}" {{ transferTo == a ? 'selected' }}>{{ a.icon }} {{ a.name }} · {{ a.currency }}</option>{% endfor %}
        </select>
    </label>
    <div class="import-rows">
        {% for i, o in parsed %}
            <div class="import-row">
                <input type="checkbox" name="keep[]" value="{{ i }}" {{ keep is null or keep[i] is defined ? 'checked' }} aria-label="Импортировать строку">
                <span class="import-main"><b>{{ o.note ?: '—' }}</b><small>{{ o.date|date('d.m.Y') }}{{ o.category ? ' · ' ~ o.category.label }}{{ o.origCurrency ? ' · ' ~ o.origAmount|money(o.origCurrency) }}</small></span>
                <span class="{{ o.type }}">{{ o.type == 'income' ? '+' : '−' }}{{ o.amount|money(o.currency) }}</span>
                <label class="chip import-transfer" title="Это перевод между своими счетами"><input type="checkbox" name="transfer[]" value="{{ i }}" {{ asTransfer[i] is defined ? 'checked' }}> ⇄</label>
            </div>
        {% endfor %}
    </div>
    {% endif %}

    <input type="hidden" name="_token" value="{{ csrf_token('form') }}">
    {% if parsed %}<button class="btn primary wide" name="confirm" value="1">Импортировать отмеченные</button>{% endif %}
    <small class="muted">Повторный импорт той же выписки дублей не создаст. Передумали после импорта — в списке операций будет кнопка «Отменить этот импорт».</small>
</form>
<details class="card"><summary>Исходные строки</summary>
    <div class="scroll"><table>{% for r in [header]|merge(sample) %}<tr>{% for c in r %}<td>{{ c }}</td>{% endfor %}</tr>{% endfor %}</table></div>
</details>
{% endblock %}
