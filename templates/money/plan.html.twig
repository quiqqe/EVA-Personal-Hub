{% extends 'money/layout.html.twig' %}
{% block body %}
<h1>Планирование</h1>

<section class="card">
    <h2>Бюджеты на месяц</h2>
    {% for b in budgets %}
        <div class="progress">
            {% set cur = b.budget.currency %}
            <div class="row"><span>{{ b.budget.category.label }}</span><span>{{ b.spent|money(cur) }} / {{ b.budget.amount|money(cur) }}</span></div>
            {% include 'money/_bar.html.twig' with {value: b.spent, max: b.budget.amount} %}
            {% if b.spent > b.budget.amount %}<small class="expense">Превышен на {{ (b.spent - b.budget.amount)|money(cur) }}</small>
            {% else %}<small class="muted">Осталось {{ (b.budget.amount - b.spent)|money(cur) }}</small>{% endif %}
            {% if b.missing %}<small class="muted"> · без учёта {{ b.missing|join(', ') }} — нет курса</small>{% endif %}
            <details class="edit-row">
                <summary>Изменить</summary>
                <form method="post" action="{{ path('money_budget_save', {scope: scope.key}) }}" class="inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('form') }}">
                    <input type="hidden" name="category" value="{{ b.budget.category.id }}">
                    <input name="amount" inputmode="decimal" value="{{ b.budget.amount|money_input(cur) }}" required aria-label="Лимит в месяц">
                    {% include '_currency_select.html.twig' with {value: cur, short: true} %}
                    <button class="btn primary small">Сохранить</button>
                    <button class="btn small danger" name="amount" value="0" formnovalidate data-confirm="Убрать бюджет «{{ b.budget.category.name }}»?">Убрать</button>
                </form>
            </details>
        </div>
    {% else %}
        <p class="muted">Задайте лимит на категорию — увидите, сколько осталось до конца месяца.</p>
    {% endfor %}
    <form method="post" action="{{ path('money_budget_save', {scope: scope.key}) }}" class="inline">
        <input type="hidden" name="_token" value="{{ csrf_token('form') }}">
        <select name="category" required>{% for c in categories %}<option value="{{ c.id }}">{{ c.label }}</option>{% endfor %}</select>
        <input name="amount" inputmode="decimal" placeholder="Лимит в месяц" required>
        {% include '_currency_select.html.twig' with {value: scope.currency, short: true} %}
        <button class="btn primary small">Задать</button>
    </form>
    <small class="muted">Траты во всех валютах пересчитываются в валюту бюджета.</small>
</section>

<section class="card">
    <h2>Цели</h2>
    {% for g in goals %}
        {% set c = g.goal.account.currency %}
        <div class="progress">
            <div class="row"><span>🎯 {{ g.goal.name }} <small class="muted">· {{ g.goal.account.name }}</small></span><span>{{ g.saved|money(c) }} / {{ g.goal.target|money(c) }}</span></div>
            {% include 'money/_bar.html.twig' with {value: g.saved, max: g.goal.target} %}
            <div class="row">
                <small class="muted">
                    {% if g.saved >= g.goal.target %}🎉 Цель достигнута!
                    {% else %}Осталось {{ (g.goal.target - g.saved)|money(c) }}
                        {% if g.goal.deadline and g.goal.deadline|date('Y-m-d') < 'now'|date('Y-m-d') %}
                            · срок {{ g.goal.deadline|date('d.m.Y') }} прошёл
                        {% elseif g.goal.deadline %}
                            {% set months = max(1, ((g.goal.deadline.timestamp - 'now'|date('U')) / 2629800)|round(0, 'ceil')) %}
                            до {{ g.goal.deadline|date('d.m.Y') }} · ≈{{ ((g.goal.target - g.saved) / months)|round|money(c) }} в месяц
                        {% endif %}
                    {% endif %}
                </small>
            </div>
            <details class="edit-row">
                <summary>Изменить</summary>
                <form method="post" action="{{ path('money_goal_save', {scope: scope.key}) }}" class="stack">
                    <input type="hidden" name="_token" value="{{ csrf_token('form') }}">
                    <input type="hidden" name="id" value="{{ g.goal.id }}">
                    <input name="name" value="{{ g.goal.name }}" required maxlength="100" aria-label="Название">
                    <select name="account" required aria-label="Счёт">{% for a in accounts %}<option value="{{ a.id }}" {{ a == g.goal.account ? 'selected' }}>{{ a.icon }} {{ a.name }} · {{ a.currency }}</option>{% endfor %}</select>
                    <input name="target" inputmode="decimal" value="{{ g.goal.target|money_input(c) }}" required aria-label="Сколько нужно">
                    <label>Срок (необязательно) <input type="date" name="deadline" value="{{ g.goal.deadline ? g.goal.deadline|date('Y-m-d') }}"></label>
                    <button class="btn primary small">Сохранить</button>
                </form>
                <form method="post" action="{{ path('money_goal_delete', {scope: scope.key, id: g.goal.id}) }}" data-confirm="Удалить цель? Счёт и деньги останутся.">
                    <input type="hidden" name="_token" value="{{ csrf_token('form') }}"><button class="btn small danger">Удалить цель</button>
                </form>
            </details>
        </div>
    {% else %}
        <p class="muted">Цель привязывается к счёту-копилке: прогресс — его баланс. Копите на отдельном счёте — заведите его в один тап:</p>
        {% if not accounts %}{% include 'money/_quick_accounts.html.twig' with {only: ['savings'], return: path('money_plan', {scope: scope.key})} %}{% endif %}
    {% endfor %}
    {% if accounts %}
    <form method="post" action="{{ path('money_goal_save', {scope: scope.key}) }}" class="stack">
        <input type="hidden" name="_token" value="{{ csrf_token('form') }}">
        <input name="name" placeholder="На что копим" required maxlength="100">
        <select name="account" required>{% for a in accounts %}<option value="{{ a.id }}" {{ a.type == 'savings' ? 'selected' }}>{{ a.icon }} {{ a.name }} · {{ a.currency }}</option>{% endfor %}</select>
        <input name="target" inputmode="decimal" placeholder="Сколько нужно" required>
        <label>Срок (необязательно) <input type="date" name="deadline"></label>
        <button class="btn primary small">Добавить цель</button>
    </form>
    {% endif %}
</section>

<section class="card">
    <div class="card-head"><h2>Регулярные операции</h2><a href="{{ path('money_recurring_new', {scope: scope.key}) }}">＋ добавить</a></div>
    {% for t in recurring %}
        <div class="row {{ t.active ? '' : 'archived' }}">
            <a href="{{ path('money_recurring_edit', {scope: scope.key, id: t.id}) }}">
                <b>{{ t.category ? t.category.label : (t.type == 'transfer' ? '🔁 Перевод' : t.note ?: 'Без категории') }}</b>
                <small class="muted"><br>{{ periods[t.period] }} · {{ t.active ? 'следующая ' ~ t.nextDate|date('d.m.Y') : 'на паузе' }} · {{ t.account.name }}{{ t.toAccount ? ' → ' ~ t.toAccount.name }}</small>
            </a>
            <span class="{{ t.type }}">{{ t.type == 'income' ? '+' : (t.type == 'expense' ? '−') }}{{ t.origCurrency ? t.origAmount|money(t.origCurrency) : t.amount|money(t.account.currency) }}{% if t.origCurrency %}{% set est = convert(t.origAmount, t.origCurrency, t.account.currency) %}<br><small class="muted">{{ est is not null ? '≈ ' ~ est|money(t.account.currency, true) ~ ' по сегодняшнему курсу' : 'пересчитается по курсу дня платежа' }}</small>{% endif %}</span>
            <form method="post" action="{{ path('money_recurring_toggle', {scope: scope.key, id: t.id}) }}" class="mini-actions">
                <input type="hidden" name="_token" value="{{ csrf_token('form') }}">
                <button class="btn small" title="{{ t.active ? 'Пауза' : 'Продолжить' }}" aria-label="{{ t.active ? 'Поставить на паузу' : 'Продолжить' }}">{{ t.active ? '⏸' : '▶️' }}</button>
                <button class="btn small" name="delete" value="1" aria-label="Удалить шаблон" title="Удалить" data-confirm="Удалить шаблон? Созданные операции останутся.">✕</button>
            </form>
        </div>
    {% else %}
        <p class="muted">Зарплата, аренда, подписки — создаются сами в нужный день.</p>
    {% endfor %}
</section>
{% endblock %}
