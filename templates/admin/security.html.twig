{% extends 'base.html.twig' %}
{% block title %}Безопасность — EVA{% endblock %}
{% block body %}
{% include 'admin/_nav.html.twig' %}
<form class="filters" method="get" data-autosubmit>
    <input type="search" name="q" value="{{ q }}" placeholder="IP, email, имя или текст">
    <select name="type" aria-label="Что показать">
        <option value="">Все события</option>
        <option value="bad" {{ type == 'bad' ? 'selected' }}>Только неудачные входы и лимиты</option>
        {% for k, v in types %}<option value="{{ k }}" {{ type == k ? 'selected' }}>{{ v }}</option>{% endfor %}
    </select>
    <noscript><button class="btn small">Показать</button></noscript>
</form>
<section class="card">
    <p class="muted small">Входы, попытки, смены пароля и ролей, события сервера (входы по SSH, проверки здоровья) — 30 дней.</p>
    {% for e in events %}
        <div class="row sec-event {{ e.type in ['login_failed', 'rate_limited'] ? 'warn' }}">
            <span>{{ types[e.type] ?? e.type }}{% if e.user %} · <b>{{ e.user.name }}</b>{% endif %}{% if e.detail %} <small class="muted">· {{ e.detail }}</small>{% endif %}<br><small class="muted">{{ e.device }}{{ e.ip ? ' · IP ' ~ e.ip }}</small></span>
            <small class="muted">{{ e.createdAt|date('d.m H:i') }}</small>
        </div>
    {% else %}
        <p class="muted">Ничего не найдено.</p>
    {% endfor %}
    <div class="actions">
        {% if page > 1 %}<a class="btn small" href="{{ path('admin_security', {type: type, q: q, page: page - 1}) }}">← Новее</a>{% endif %}
        {% if more %}<a class="btn small" href="{{ path('admin_security', {type: type, q: q, page: page + 1}) }}">Старее →</a>{% endif %}
    </div>
</section>
{% endblock %}
