{% extends 'base.html.twig' %}
{% block title %}Администрирование — EVA{% endblock %}
{% block body %}
{% include 'admin/_nav.html.twig' %}

<section class="card">
    <h2>За сутки</h2>
    <div class="admin-stats">
        <a href="{{ path('admin_errors') }}"><b class="{{ day.errors ? 'expense' }}">{{ day.errors }}</b><small>ошибок · открыто {{ day.open }}</small></a>
        <a href="{{ path('admin_security', {type: 'bad'}) }}"><b class="{{ day.failed ? 'expense' }}">{{ day.failed }}</b><small>неудачных входов</small></a>
        <a href="{{ path('admin_security', {type: 'login'}) }}"><b>{{ day.logins }}</b><small>входов</small></a>
        <a href="{{ path('admin_security', {type: 'server'}) }}"><b>{{ day.server }}</b><small>событий сервера</small></a>
    </div>
</section>

<section class="card">
    <h2>Состояние</h2>
    <div class="row"><span>Telegram-бот</span><b class="{{ state.bot ? 'income' : 'expense' }}">{{ state.bot ? 'настроен' : 'не настроен' }}</b></div>
    <div class="row"><span>Уведомления</span><b class="{{ state.alertsTo ? 'income' : 'expense' }}">{{ state.alertsTo == 'chat' ? 'в чат уведомлений' : (state.alertsTo == 'admins' ? 'администраторам в Telegram' : 'никуда — нет администратора с Telegram') }}</b></div>
    <div class="row"><span>Bugsink</span><b class="{{ state.sentry ? 'income' : 'expense' }}">{{ state.sentry ? 'подключён' : 'не подключён' }}</b></div>
    <div class="row"><span>Администраторы</span><span>{% for a in state.admins %}{{ a.name }} <small class="muted">({{ constant('App\\Entity\\User::ROLES')[a.role] }}{{ a.telegramId ? '' : ', без Telegram' }})</small>{{ not loop.last ? ', ' }}{% endfor %}</span></div>
    <div class="row"><span>Окружение</span><span>{{ state.env }}</span></div>
    <form method="post" action="{{ path('admin_test') }}" class="actions">
        <input type="hidden" name="_token" value="{{ csrf_token('form') }}">
        <button class="btn small">{{ icon('send') }} Тестовое уведомление</button>
        <button class="btn small" name="error" value="1">{{ icon('x') }} Тестовая ошибка</button>
    </form>
</section>
{% endblock %}
